// ── DATA UTILS ──
function escapeHtml(str){
  if(!str) return '';
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function exportData(){
  const json = JSON.stringify(STATE, null, 2);
  const blob = new Blob([json],{type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href=url; a.download='4lhavraid-data-'+Date.now()+'.json';
  a.click(); URL.revokeObjectURL(url);
  notify('Données exportées !','success');
}

function resetAll(){
  if(confirm('⚠️ Supprimer TOUTES les données ? Cette action est irréversible.')){
    localStorage.removeItem('havraid_state');
    sessionStorage.removeItem('havraid_session');
    location.reload();
  }
}

// ── TICKET SYSTEM ──
function submitTicket(){
  const name = document.getElementById('tkt-name').value.trim();
  const subject = document.getElementById('tkt-subject').value.trim();
  const message = document.getElementById('tkt-message').value.trim();
  if(!name){notify('Veuillez entrer votre nom','error');return;}
  if(!subject){notify('Veuillez entrer un sujet','error');return;}
  if(message.length < 10){notify('Le message est trop court (min 10 caractères)','error');return;}
  // Check daily limit (5 per day)
  const today = new Date().toDateString();
  const dailyKey = '4lhavraid_daily_'+today;
  const dailyCount = parseInt(localStorage.getItem(dailyKey)||'0');
  if(dailyCount >= 5){notify('Limite de 5 demandes par jour atteinte','error');return;}
  const ticketId = 'TKT-' + Date.now().toString(36).toUpperCase();
  const ticket = {id:ticketId, name, subject, message, date:new Date().toISOString(), status:'Nouveau', response:''};
  const tickets = JSON.parse(localStorage.getItem('4lhavraid_tickets')||'[]');
  tickets.unshift(ticket);
  localStorage.setItem('4lhavraid_tickets', JSON.stringify(tickets));
  localStorage.setItem(dailyKey, (dailyCount+1).toString());
  document.getElementById('tkt-id').textContent = ticketId;
  document.getElementById('ticket-form-wrap').style.display='none';
  document.getElementById('ticket-success').style.display='block';
  document.getElementById('ticket-daily-count').textContent = (dailyCount+1)+'/5 demandes envoyées aujourd\'hui.';
  document.getElementById('tkt-name').value='';
  document.getElementById('tkt-subject').value='';
  document.getElementById('tkt-message').value='';
  document.getElementById('tkt-chars').textContent='0';
}
// Update daily ticket counter on load
(function(){
  const today = new Date().toDateString();
  const count = parseInt(localStorage.getItem('4lhavraid_daily_'+today)||'0');
  const el = document.getElementById('ticket-daily-count');
  if(el) el.textContent = count+'/5 demandes envoyées aujourd\'hui.';
})();

