const KM_STEP = 1;
const KM_MAX = 6000;

function buildKmGrid(){
  const grid = document.getElementById('km-grid');
  grid.innerHTML = '';
  for(let km=1; km<=KM_MAX; km++){
    const cell = document.createElement('div');
    const isAdopted = STATE.adopted[km];
    const isMine = STATE.user && isAdopted && isAdopted.email === STATE.user.email;
    cell.className = 'km-cell' + (isAdopted ? (isMine?' mine':' adopted') : '');
    cell.innerHTML = `<div style="font-weight:500;color:${isAdopted?(isMine?'var(--green-light)':'var(--terra)'):'var(--accent)'};font-size:11px;">${km}</div><div style="font-size:10px;margin-top:1px;">km</div>`;
    if(!isAdopted){
      cell.onclick = ()=>openKmModal(km);
      cell.title = `Adopter le km ${km}`;
    } else {
      cell.title = isAdopted.name + (isAdopted.amount ? ' · '+isAdopted.amount+' €':'');
      if(isMine){ cell.onclick=()=>scrollToPhotos(); cell.title='Votre km — voir votre photo'; }
    }
    grid.appendChild(cell);
  }
}

function openKmModal(km){
  document.getElementById('km-modal-title').textContent = 'Km '+km;
