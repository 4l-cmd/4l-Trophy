function sendAuthCode(){
  const email = document.getElementById('auth-email').value.trim().toLowerCase();
  if(!email || !email.includes('@')){ notify('Email invalide','error'); return; }
  authEmail = email;
  authCode = String(Math.floor(100000+Math.random()*900000));

  // In production: send via EmailJS
  // emailjs.send("service_id","template_id",{to_email:email,code:authCode});

  document.getElementById('auth-step1').style.display='none';
  document.getElementById('auth-step2').style.display='block';
  document.getElementById('auth-step2-sub').textContent = 'Code envoyé à '+email+' (mode démo : code affiché ci-dessous)';
  document.getElementById('auth-code-demo').style.display='block';
  document.getElementById('auth-code-value').textContent = authCode;
}

function backToStep1(){
  document.getElementById('auth-step1').style.display='block';
  document.getElementById('auth-step2').style.display='none';
}

function verifyCode(){
  const input = document.getElementById('auth-code-input').value.trim();
  if(input !== authCode){ notify('Code incorrect','error'); return; }

  const isAdmin = STATE.config.adminEmails.map(e=>e.toLowerCase()).includes(authEmail);
  STATE.user = { email:authEmail, isAdmin };

  const remember = document.getElementById('auth-remember')?.checked;
  if(remember) localStorage.setItem('havraid_remember', authEmail);

  sessionStorage.setItem('havraid_session', JSON.stringify({email:authEmail,isAdmin, exp:Date.now()+86400000}));

  // Log connection
  const connEntry = {email:authEmail, isAdmin, date:new Date().toLocaleDateString('fr-FR'), time:new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'}), agent:navigator.userAgent.substring(0,80)};
  if(!STATE.connections) STATE.connections = [];
  STATE.connections.unshift(connEntry);
  if(STATE.connections.length > 200) STATE.connections = STATE.connections.slice(0,200);
  saveState();

  closeModal('auth-modal');
  updateUserUI();
  renderKmPhotos();
  notify(isAdmin ? '👋 Bienvenue admin !' : '✅ Connecté : '+authEmail, 'success');
}

function checkSession(){
  try{
    const s = sessionStorage.getItem('havraid_session');
    if(s){
      const sess = JSON.parse(s);
      if(sess.exp > Date.now()){
        STATE.user = {email:sess.email,isAdmin:sess.isAdmin};
        updateUserUI();
        renderKmPhotos();
      }
    }
  }catch(e){}
}

