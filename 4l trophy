<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>4L HAVRAID — 4L Trophy 2026</title>
<meta name="description" content="Suivez l'aventure 4L HAVRAID du Havre à Marrakech. Adoptez un kilomètre, devenez sponsor, suivez notre parcours en temps réel.">
<meta name="keywords" content="4L Trophy 2026, 4L HAVRAID, sponsor raid étudiant, adopter kilomètre, Le Havre Marrakech">
<meta property="og:title" content="4L HAVRAID — 4L Trophy 2026">
<meta property="og:description" content="6000 km du Havre à Marrakech. Adoptez un kilomètre ou devenez sponsor !">
<meta property="og:type" content="website">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
:root{--sand:#F5ECD7;--sand-dark:#E8D5B0;--terra:#C4622D;--terra-dark:#9B4A1F;--green:#2D6A4F;--green-light:#52B788;--night:#0D1117;--night2:#161B22;--night3:#21262D;--muted:#8B949E;--text:#E6EDF3;--text-dim:#C9D1D9;--accent:#F0A500;--blue:#1F6FEB;}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--night);color:var(--text);font-family:'Outfit',sans-serif;font-weight:300;overflow-x:hidden;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:500;display:flex;align-items:center;justify-content:space-between;padding:14px 32px;background:rgba(13,17,23,0.95);backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,255,255,0.06);}
.nav-logo{font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:3px;color:var(--accent);text-decoration:none;cursor:pointer;}
.nav-links{display:flex;gap:24px;align-items:center;}
.nav-links a{font-size:12px;font-weight:400;color:var(--muted);text-decoration:none;letter-spacing:1px;text-transform:uppercase;transition:color .2s;}
.nav-links a:hover{color:var(--text);}
.nav-btn{background:var(--terra);color:white;border:none;padding:8px 20px;border-radius:4px;font-family:'Outfit',sans-serif;font-size:12px;font-weight:500;letter-spacing:1px;text-transform:uppercase;cursor:pointer;transition:background .2s;}
.nav-btn:hover{background:var(--terra-dark);}
.nav-user{display:flex;align-items:center;gap:10px;}
.nav-user-name{font-size:12px;color:var(--green-light);}

/* HERO */
#hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:120px 40px 80px;position:relative;overflow:hidden;}
.hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse 80% 50% at 50% 100%,rgba(196,98,45,.2) 0%,transparent 70%),radial-gradient(ellipse 60% 40% at 20% 20%,rgba(240,165,0,.08) 0%,transparent 60%);}
.hero-tag{font-size:12px;font-weight:500;letter-spacing:4px;text-transform:uppercase;color:var(--accent);margin-bottom:24px;border:1px solid rgba(240,165,0,.3);padding:6px 20px;border-radius:100px;display:inline-block;position:relative;z-index:1;}
.hero-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(60px,11vw,140px);line-height:.9;letter-spacing:4px;color:var(--sand);position:relative;z-index:1;}
.hero-title span{color:var(--terra);}
.hero-sub{font-size:17px;font-weight:300;color:var(--muted);margin:28px 0 48px;max-width:500px;line-height:1.7;position:relative;z-index:1;}
.hero-btns{display:flex;gap:16px;flex-wrap:wrap;justify-content:center;position:relative;z-index:1;}
.btn-primary{background:var(--terra);color:white;padding:14px 36px;border-radius:4px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:500;letter-spacing:1px;text-transform:uppercase;border:none;cursor:pointer;text-decoration:none;display:inline-block;transition:background .2s,transform .15s;}
.btn-primary:hover{background:var(--terra-dark);transform:translateY(-2px);}
.btn-ghost{background:transparent;color:var(--text-dim);padding:14px 36px;border-radius:4px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:400;letter-spacing:1px;text-transform:uppercase;border:1px solid rgba(255,255,255,.15);cursor:pointer;text-decoration:none;display:inline-block;transition:border-color .2s,color .2s;}
.btn-ghost:hover{border-color:rgba(255,255,255,.4);color:white;}
.dunes{position:absolute;bottom:0;left:0;right:0;z-index:0;}

/* STATS BAR */
.stats-bar{background:var(--night2);border-top:1px solid rgba(255,255,255,.06);border-bottom:1px solid rgba(255,255,255,.06);display:flex;justify-content:center;flex-wrap:wrap;}
.stat-item{padding:24px 44px;text-align:center;border-right:1px solid rgba(255,255,255,.06);}
.stat-item:last-child{border-right:none;}
.stat-num{font-family:'Bebas Neue',sans-serif;font-size:42px;letter-spacing:2px;color:var(--accent);line-height:1;}
.stat-label{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-top:6px;}

/* SECTIONS */
section{padding:90px 40px;max-width:1100px;margin:0 auto;}
.section-tag{font-size:11px;letter-spacing:4px;text-transform:uppercase;color:var(--terra);margin-bottom:14px;font-weight:500;}
h2{font-family:'Bebas Neue',sans-serif;font-size:clamp(38px,5.5vw,68px);letter-spacing:2px;color:var(--sand);line-height:1;margin-bottom:18px;}
.section-lead{font-size:16px;color:var(--muted);line-height:1.8;max-width:540px;margin-bottom:56px;}

/* NEWS / ACTUALITÉS */
.news-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;}
.news-card{background:var(--night2);border:1px solid rgba(255,255,255,.06);border-radius:8px;overflow:hidden;transition:border-color .2s;}
.news-card:hover{border-color:rgba(255,255,255,.15);}
.news-card-img{width:100%;height:160px;object-fit:cover;background:var(--night3);}
.news-card-img-placeholder{width:100%;height:160px;background:var(--night3);display:flex;align-items:center;justify-content:center;font-size:32px;}
.news-card-body{padding:20px;}
.news-badge{font-size:10px;letter-spacing:2px;text-transform:uppercase;padding:3px 10px;border-radius:100px;margin-bottom:10px;display:inline-block;}
.badge-sponsor{background:rgba(240,165,0,.15);color:var(--accent);}
.badge-etape{background:rgba(82,183,136,.15);color:var(--green-light);}
.badge-km{background:rgba(196,98,45,.15);color:var(--terra);}
.badge-equipe{background:rgba(31,111,235,.15);color:#58a6ff;}
.news-card-title{font-size:15px;font-weight:500;color:var(--text);margin-bottom:8px;}
.news-card-text{font-size:13px;color:var(--muted);line-height:1.6;}
.news-card-date{font-size:11px;color:var(--muted);margin-top:12px;opacity:.6;}
.news-empty{color:var(--muted);font-size:14px;}

/* ÉQUIPE */
.team-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:24px;}
.team-card{background:var(--night2);border:1px solid rgba(255,255,255,.06);border-radius:8px;overflow:hidden;text-align:center;}
.team-photo{width:100%;height:220px;object-fit:cover;background:var(--night3);}
.team-photo-placeholder{width:100%;height:220px;background:var(--night3);display:flex;align-items:center;justify-content:center;font-size:48px;}
.team-body{padding:20px;}
.team-name{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:2px;color:var(--sand);}
.team-role{font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--terra);margin-top:4px;}
.team-bio{font-size:13px;color:var(--muted);margin-top:10px;line-height:1.6;}
.team-insta{display:flex;align-items:center;justify-content:center;gap:6px;margin-top:12px;font-size:12px;color:var(--muted);text-decoration:none;}
.team-insta:hover{color:var(--text);}
.team-empty{color:var(--muted);font-size:14px;}

/* VOITURE */
#voiture{background:var(--night2);border-radius:0;margin:0;max-width:100%;padding:90px 40px;}
#voiture>*{max-width:1100px;margin-left:auto;margin-right:auto;}
.car-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;margin-top:40px;}
.car-photo{width:100%;height:200px;object-fit:cover;border-radius:6px;background:var(--night3);}

/* ADOPTER UN KM */
.progress-wrap{margin-bottom:48px;}
.progress-labels{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);margin-bottom:10px;}
.progress-bar{height:6px;background:var(--night3);border-radius:3px;overflow:hidden;}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--terra),var(--accent));border-radius:3px;transition:width .6s ease;}
.km-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(72px,1fr));gap:6px;max-height:320px;overflow-y:auto;padding-right:8px;}
.km-grid::-webkit-scrollbar{width:4px;}
.km-grid::-webkit-scrollbar-track{background:var(--night2);}
.km-grid::-webkit-scrollbar-thumb{background:var(--night3);border-radius:2px;}
.km-cell{background:var(--night2);border:1px solid rgba(255,255,255,.06);border-radius:4px;padding:8px 4px;text-align:center;font-size:11px;font-weight:400;color:var(--muted);cursor:pointer;transition:all .15s;user-select:none;}
.km-cell:hover{background:var(--night3);border-color:rgba(255,255,255,.15);color:var(--text);}
.km-cell.adopted{background:rgba(196,98,45,.15);border-color:var(--terra);color:var(--terra);cursor:default;font-weight:500;}
.km-cell.adopted:hover{transform:none;}
.km-cell.mine{background:rgba(82,183,136,.2);border-color:var(--green-light);color:var(--green-light);cursor:pointer;}
.km-photos-section{margin-top:60px;}
.km-photo-card{background:var(--night2);border:1px solid var(--green-light);border-radius:8px;overflow:hidden;margin-bottom:16px;}
.km-photo-header{padding:16px 20px;border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;gap:12px;}
.km-photo-badge{font-family:'Bebas Neue',sans-serif;font-size:24px;color:var(--accent);}
.km-photo-img{width:100%;max-height:300px;object-fit:cover;}
.km-photo-msg{padding:16px 20px;font-size:13px;color:var(--muted);}

/* SPONSORS */
#sponsors{background:var(--night2);border-radius:0;margin:0;max-width:100%;padding:90px 40px;}
#sponsors>*{max-width:1100px;margin-left:auto;margin-right:auto;}
.sponsor-layout{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start;margin-top:40px;}
@media(max-width:800px){.sponsor-layout{grid-template-columns:1fr;}}
.car-svg-wrap{position:relative;}
.car-svg-wrap svg{width:100%;max-width:460px;display:block;margin:0 auto;}
.sticker-pos{cursor:pointer;transition:all .2s;}
.sticker-pos circle{transition:all .2s;}
.sticker-pos:hover circle{r:18;}
.sticker-pos.taken circle{fill:rgba(240,165,0,.3)!important;stroke:var(--accent)!important;}
.sticker-pos.taken text{fill:var(--accent)!important;}
.sponsor-info-panel{padding:24px;background:var(--night3);border-radius:8px;border:1px solid rgba(255,255,255,.08);}
.sponsor-pos-title{font-family:'Bebas Neue',sans-serif;font-size:32px;color:var(--sand);letter-spacing:2px;}
.sponsor-pos-detail{font-size:13px;color:var(--muted);margin-top:8px;line-height:1.7;}
.price-table{width:100%;border-collapse:collapse;margin-top:20px;}
.price-table th{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);padding:8px 12px;text-align:left;border-bottom:1px solid rgba(255,255,255,.06);}
.price-table td{padding:10px 12px;font-size:14px;border-bottom:1px solid rgba(255,255,255,.04);}
.price-big{color:var(--accent);font-weight:500;}
.price-small{color:var(--green-light);font-weight:500;}
.sponsor-btn{width:100%;margin-top:20px;}
.sponsors-list{margin-top:60px;}
.sponsors-grid{display:flex;flex-wrap:wrap;gap:16px;margin-top:24px;}
.sponsor-badge{background:var(--night3);border:1px solid rgba(255,255,255,.08);border-radius:6px;padding:12px 20px;display:flex;align-items:center;gap:12px;}
.sponsor-badge img{height:32px;width:auto;object-fit:contain;filter:grayscale(30%);}
.sponsor-badge-name{font-size:13px;font-weight:500;color:var(--text-dim);}
.sponsor-badge-pos{font-size:11px;color:var(--muted);}
.dossier-section{margin-top:48px;background:var(--night3);border-radius:8px;padding:28px;border:1px solid rgba(255,255,255,.08);}
.dossier-title{font-family:'Bebas Neue',sans-serif;font-size:26px;color:var(--sand);letter-spacing:2px;margin-bottom:12px;}
.dossier-text{font-size:14px;color:var(--muted);line-height:1.7;margin-bottom:20px;}
/* Navigation section cards */
.nav-section-card{display:flex;flex-direction:column;background:var(--night3);border:1px solid rgba(255,255,255,.07);border-radius:12px;padding:28px 24px;transition:all .25s;cursor:pointer;}
.nav-section-card:hover{border-color:var(--terra);transform:translateY(-4px);box-shadow:0 8px 30px rgba(196,98,45,.2);}
.nav-section-icon{font-size:36px;margin-bottom:14px;}
.nav-section-title{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:2px;color:var(--sand);margin-bottom:10px;}
.nav-section-desc{font-size:13px;color:var(--muted);line-height:1.65;flex:1;}
.nav-section-cta{margin-top:18px;font-size:13px;font-weight:600;color:var(--terra);letter-spacing:.5px;}
/* Car views tabs */
.car-views-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;}
.car-view-tab{background:var(--night3);border:1px solid rgba(255,255,255,.1);border-radius:6px;padding:8px 16px;font-size:12px;letter-spacing:1px;color:var(--muted);cursor:pointer;transition:all .2s;text-transform:uppercase;}
.car-view-tab.active{background:var(--terra);border-color:var(--terra);color:white;}
.car-view-panel{display:none;}
.car-view-panel.active{display:block;}

/* GPS / SUIVI */
#suivi{padding:90px 40px;}
.suivi-inner{max-width:1100px;margin:0 auto;}
#map{width:100%;height:380px;border-radius:8px;border:1px solid rgba(255,255,255,.08);overflow:hidden;margin-bottom:28px;}
.map-header{padding:12px 18px;background:var(--night2);border:1px solid rgba(255,255,255,.08);border-bottom:none;border-radius:8px 8px 0 0;display:flex;align-items:center;justify-content:space-between;}
.map-header-left{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--muted);}
.live-dot{width:8px;height:8px;border-radius:50%;background:#2ea043;animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.3;}}
#map{border-radius:0 0 8px 8px!important;}
.stages-wrap{display:flex;gap:0;flex-wrap:wrap;margin-bottom:32px;background:var(--night2);border:1px solid rgba(255,255,255,.06);border-radius:8px;overflow:hidden;}
.stage-item{flex:1;min-width:120px;padding:14px 16px;border-right:1px solid rgba(255,255,255,.06);text-align:center;position:relative;}
.stage-item:last-child{border-right:none;}
.stage-icon{font-size:22px;margin-bottom:6px;}
.stage-name{font-size:11px;font-weight:500;color:var(--muted);letter-spacing:1px;text-transform:uppercase;}
.stage-item.done .stage-name{color:var(--green-light);}
.stage-item.done::after{content:'✓';position:absolute;top:8px;right:8px;font-size:12px;color:var(--green-light);}
.stage-item.current{background:rgba(196,98,45,.1);}
.stage-item.current .stage-name{color:var(--terra);}
.log-list{display:flex;flex-direction:column;gap:0;}
.log-entry{display:flex;gap:18px;align-items:flex-start;padding:16px 0;border-bottom:1px solid rgba(255,255,255,.06);animation:fadeIn .3s ease;}
@keyframes fadeIn{from{opacity:0;transform:translateY(-6px);}to{opacity:1;transform:none;}}
.log-time{font-family:'Bebas Neue',sans-serif;font-size:18px;color:var(--accent);letter-spacing:1px;min-width:56px;line-height:1;padding-top:2px;}
.log-place{font-size:13px;font-weight:500;color:var(--text);margin-bottom:4px;}
.log-msg{font-size:13px;color:var(--muted);line-height:1.5;}
.gps-btn{display:flex;gap:12px;margin-bottom:28px;flex-wrap:wrap;}

/* CONTACT */
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:40px;}
@media(max-width:700px){.contact-grid{grid-template-columns:1fr;}}
.contact-card{background:var(--night2);border:1px solid rgba(255,255,255,.06);border-radius:8px;padding:28px;}
.contact-label{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--terra);margin-bottom:8px;}
.contact-value{font-size:16px;font-weight:500;color:var(--text);}
.contact-sub{font-size:13px;color:var(--muted);margin-top:4px;}
.contact-value a{color:var(--text);text-decoration:none;}
.contact-value a:hover{color:var(--accent);}
.contact-cagnotte{background:linear-gradient(135deg,rgba(240,165,0,.15),rgba(196,98,45,.1));border:1px solid rgba(240,165,0,.25);border-radius:8px;padding:28px;text-align:center;margin-top:24px;}
.cagnotte-title{font-family:'Bebas Neue',sans-serif;font-size:28px;color:var(--accent);letter-spacing:2px;}
.cagnotte-text{font-size:14px;color:var(--muted);margin:8px 0 20px;line-height:1.6;}
.insta-btn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);color:white;padding:10px 24px;border-radius:100px;font-size:13px;font-weight:500;text-decoration:none;transition:opacity .2s;}
.insta-btn:hover{opacity:.85;}

/* FOOTER */
footer{background:var(--night2);border-top:1px solid rgba(255,255,255,.06);padding:40px;text-align:center;}
.footer-links{display:flex;gap:24px;justify-content:center;flex-wrap:wrap;margin-bottom:20px;}
.footer-links a{font-size:12px;color:var(--muted);text-decoration:none;letter-spacing:1px;text-transform:uppercase;}
.footer-links a:hover{color:var(--text);}
.footer-copy{font-size:12px;color:var(--muted);}
.footer-copy strong{color:var(--terra);}
.footer-siren{font-size:11px;color:var(--muted);opacity:.5;margin-top:8px;}

/* MODALS */
.modal-overlay{display:none;position:fixed;inset:0;z-index:600;background:rgba(0,0,0,.75);backdrop-filter:blur(4px);align-items:center;justify-content:center;}
.modal-overlay.open{display:flex;}
.modal-box{background:var(--night2);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:36px;width:420px;max-width:96vw;max-height:90vh;overflow-y:auto;}
.modal-title{font-family:'Bebas Neue',sans-serif;font-size:32px;color:var(--sand);letter-spacing:2px;margin-bottom:6px;}
.modal-sub{font-size:13px;color:var(--muted);margin-bottom:24px;}
.form-group{margin-bottom:14px;}
.form-group label{display:block;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin-bottom:6px;}
.form-group input,.form-group textarea,.form-group select{width:100%;background:var(--night3);border:1px solid rgba(255,255,255,.08);border-radius:4px;padding:10px 14px;color:var(--text);font-family:'Outfit',sans-serif;font-size:14px;outline:none;transition:border-color .2s;}
.form-group input:focus,.form-group textarea:focus,.form-group select:focus{border-color:var(--terra);}
.form-group input::placeholder,.form-group textarea::placeholder{color:var(--muted);}
.form-group select option{background:var(--night3);}
.form-group textarea{resize:vertical;min-height:80px;}
.modal-btns{display:flex;gap:10px;margin-top:20px;}
.modal-btns button{flex:1;}
.btn-cancel{background:transparent;color:var(--muted);padding:10px;border:1px solid rgba(255,255,255,.1);border-radius:4px;font-family:'Outfit',sans-serif;font-size:13px;cursor:pointer;transition:all .15s;}
.btn-cancel:hover{border-color:rgba(255,255,255,.3);color:var(--text);}
.btn-confirm{background:var(--terra);color:white;padding:10px;border:none;border-radius:4px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:background .15s;}
.btn-confirm:hover{background:var(--terra-dark);}
.btn-success{background:var(--green);color:white;padding:10px;border:none;border-radius:4px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:500;cursor:pointer;}
.code-display{background:var(--night3);border:1px solid var(--accent);border-radius:6px;padding:16px;text-align:center;margin:16px 0;}
.code-display span{font-family:'Bebas Neue',sans-serif;font-size:40px;letter-spacing:8px;color:var(--accent);}
.modal-km{font-family:'Bebas Neue',sans-serif;font-size:44px;color:var(--terra);letter-spacing:2px;line-height:1;}
.msg-toggle{display:flex;gap:10px;margin-top:14px;}
.msg-toggle label{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--muted);cursor:pointer;}
.msg-toggle input[type=radio]{accent-color:var(--terra);}

/* ADMIN PANEL */
#admin-panel{position:fixed;top:0;right:0;bottom:0;width:420px;max-width:100vw;background:var(--night2);border-left:1px solid rgba(255,255,255,.1);z-index:800;transform:translateX(100%);transition:transform .3s;display:flex;flex-direction:column;}
#admin-panel.open{transform:translateX(0);}
.admin-header{padding:20px 24px;border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.admin-title{font-family:'Bebas Neue',sans-serif;font-size:22px;color:var(--sand);letter-spacing:2px;}
.admin-close{background:none;border:none;color:var(--muted);font-size:20px;cursor:pointer;}
.admin-tabs{display:flex;border-bottom:1px solid rgba(255,255,255,.06);flex-shrink:0;overflow-x:auto;}
.admin-tab{padding:12px 16px;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;white-space:nowrap;background:none;border-left:none;border-right:none;border-top:none;transition:all .2s;}
.admin-tab.active{color:var(--accent);border-bottom-color:var(--accent);}
.admin-content{flex:1;overflow-y:auto;padding:20px 24px;}
.admin-section{display:none;}
.admin-section.active{display:block;}
.admin-field{margin-bottom:14px;}
.admin-field label{display:block;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin-bottom:5px;}
.admin-field input,.admin-field textarea,.admin-field select{width:100%;background:var(--night3);border:1px solid rgba(255,255,255,.08);border-radius:4px;padding:8px 12px;color:var(--text);font-family:'Outfit',sans-serif;font-size:13px;outline:none;}
.admin-field input:focus,.admin-field textarea:focus{border-color:var(--terra);}
.admin-btn{background:var(--terra);color:white;border:none;padding:8px 16px;border-radius:4px;font-family:'Outfit',sans-serif;font-size:12px;font-weight:500;cursor:pointer;text-transform:uppercase;letter-spacing:1px;transition:background .2s;}
.admin-btn:hover{background:var(--terra-dark);}
.admin-btn-ghost{background:transparent;color:var(--muted);border:1px solid rgba(255,255,255,.1);padding:8px 16px;border-radius:4px;font-family:'Outfit',sans-serif;font-size:12px;cursor:pointer;text-transform:uppercase;letter-spacing:1px;}
.admin-btn-ghost:hover{color:var(--text);border-color:rgba(255,255,255,.3);}
.admin-btn-green{background:var(--green);color:white;border:none;padding:8px 16px;border-radius:4px;font-family:'Outfit',sans-serif;font-size:12px;font-weight:500;cursor:pointer;}
.admin-list-item{background:var(--night3);border-radius:6px;padding:12px;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between;gap:8px;}
.admin-list-item-text{font-size:13px;color:var(--text-dim);flex:1;}
.admin-list-item-sub{font-size:11px;color:var(--muted);}
.admin-delete{background:none;border:none;color:var(--muted);cursor:pointer;font-size:16px;padding:2px 6px;}
.admin-delete:hover{color:#f85149;}
.stage-check-item{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.04);}
.stage-check-item label{font-size:13px;color:var(--text-dim);flex:1;cursor:pointer;}
.stage-check-item input[type=checkbox]{accent-color:var(--green-light);width:16px;height:16px;cursor:pointer;}
.stage-check-item .stage-check-icon{font-size:18px;}
.admin-stat-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px;}
.admin-stat-card{background:var(--night3);border-radius:6px;padding:14px;text-align:center;}
.admin-stat-num{font-family:'Bebas Neue',sans-serif;font-size:28px;color:var(--accent);}
.admin-stat-lbl{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin-top:2px;}
.toggle-switch{position:relative;display:inline-block;width:40px;height:22px;}
.toggle-switch input{opacity:0;width:0;height:0;}
.toggle-slider{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:var(--night3);border-radius:22px;transition:.3s;}
.toggle-slider:before{position:absolute;content:"";height:16px;width:16px;left:3px;bottom:3px;background:var(--muted);border-radius:50%;transition:.3s;}
.toggle-switch input:checked+.toggle-slider{background:var(--green);}
.toggle-switch input:checked+.toggle-slider:before{transform:translateX(18px);background:white;}
.section-full{padding:90px 40px;background:var(--night2);margin:0;max-width:100%;}
.section-full>.inner{max-width:1100px;margin:0 auto;}

/* LEGAL MODAL */
.legal-content{font-size:13px;color:var(--text-dim);line-height:1.8;max-height:60vh;overflow-y:auto;padding-right:8px;}
.legal-content h3{font-family:'Bebas Neue',sans-serif;font-size:20px;color:var(--sand);letter-spacing:1px;margin:20px 0 8px;}
.legal-content p{margin-bottom:12px;}

/* NOTIFICATION */
.notif{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--night2);border:1px solid rgba(255,255,255,.1);border-radius:6px;padding:12px 24px;font-size:14px;z-index:900;transition:opacity .3s;pointer-events:none;}
.notif.success{border-color:var(--green-light);color:var(--green-light);}
.notif.error{border-color:#f85149;color:#f85149;}
.notif.info{border-color:var(--accent);color:var(--accent);}

/* DONOR SECTION */
.donors-list{display:flex;flex-wrap:wrap;gap:10px;margin-top:32px;}
.donor-badge{background:var(--night2);border:1px solid rgba(255,255,255,.08);border-radius:100px;padding:7px 16px;font-size:13px;color:var(--text-dim);display:flex;align-items:center;gap:8px;}
.donor-km{font-weight:500;color:var(--terra);}
.donor-amount{color:var(--accent);font-weight:500;}

/* MEDIA QUERIES */
@media(max-width:700px){
  nav{padding:12px 16px;}
  .nav-links a{display:none;}
  section{padding:60px 20px;}
  .stat-item{padding:18px 20px;}
  #admin-panel{width:100vw;}
}

/* STRIPE SECTION INSIDE MODAL */
.stripe-info{background:var(--night3);border-radius:6px;padding:16px;margin:16px 0;font-size:13px;color:var(--muted);line-height:1.7;}
.stripe-info strong{color:var(--text);}
.price-display{font-family:'Bebas Neue',sans-serif;font-size:36px;color:var(--accent);letter-spacing:2px;margin:12px 0;}
.company-tier-info{background:rgba(240,165,0,.08);border:1px solid rgba(240,165,0,.2);border-radius:6px;padding:12px 16px;font-size:13px;color:var(--accent);margin:12px 0;}
.km-price-btn{background:var(--night3);border:1px solid rgba(255,255,255,.1);border-radius:4px;padding:8px 14px;color:var(--text-dim);font-family:'Outfit',sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:all .15s;}
.km-price-btn:hover{border-color:var(--terra);color:var(--terra);}
.km-price-btn.selected{background:rgba(196,98,45,.2);border-color:var(--terra);color:var(--terra);}
/* Connexions tab */
.conn-item{background:var(--night3);border-radius:6px;padding:10px 14px;margin-bottom:6px;display:flex;align-items:center;justify-content:space-between;gap:8px;}
.conn-email{font-size:13px;color:var(--text-dim);font-weight:500;}
.conn-time{font-size:11px;color:var(--muted);}
.conn-admin{font-size:10px;background:rgba(240,165,0,.2);color:var(--accent);padding:2px 6px;border-radius:3px;letter-spacing:1px;}
</style>
</head>
<body>

