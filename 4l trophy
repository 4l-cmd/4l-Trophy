  if(!STATE.config.bigCompanies.includes(name)) STATE.config.bigCompanies.push(name);
  saveState(); renderBigCompaniesList();
  document.getElementById('cfg-big-company').value='';
}

function renderBigCompaniesList(){
  const list = document.getElementById('big-companies-list');
  if(!list) return;
  list.innerHTML = STATE.config.bigCompanies.map((c,i)=>`
    <div class="admin-list-item" style="padding:6px 10px;">
      <div class="admin-list-item-text">${escapeHtml(c)}</div>
      <button class="admin-delete" onclick="removeBigCompany(${i})">✕</button>
    </div>
  `).join('');
}

function removeBigCompany(i){ STATE.config.bigCompanies.splice(i,1); saveState(); renderBigCompaniesList(); }

function usePhoneGPS(){
  if(!navigator.geolocation){ notify('Géolocalisation non supportée','error'); return; }
  notify('Récupération de la position...','info');
  navigator.geolocation.getCurrentPosition(
    (pos)=>{
      document.getElementById('gps-lat-input').value = pos.coords.latitude.toFixed(5);
      document.getElementById('gps-lng-input').value = pos.coords.longitude.toFixed(5);
      notify('Position GPS récupérée !','success');
    },
    (err)=>{ notify('Erreur GPS : '+err.message,'error'); }
  );
}

function addGPSLog(){
  const place = getValue('gps-place-input');
  const msg = getValue('gps-msg-input');
  const lat = parseFloat(document.getElementById('gps-lat-input').value);
  const lng = parseFloat(document.getElementById('gps-lng-input').value);
  if(!place){ notify('Lieu requis','error'); return; }
  const now = new Date();
  const time = now.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'})+' · '+now.toLocaleDateString('fr-FR');
  STATE.gpsLog.push({time,place,msg,lat:lat||null,lng:lng||null});
  saveState(); renderGpsLog();
  addAutoNews('etape','📍 '+place, msg||'L\'équipage est à '+place);
  renderNews();
  document.getElementById('gps-place-input').value='';
  document.getElementById('gps-msg-input').value='';
  notify('Position mise à jour !','success');
}

