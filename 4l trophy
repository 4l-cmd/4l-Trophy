  const visibility = document.querySelector('input[name="km-msg-visibility"]:checked')?.value || 'public';
  const amount = parseInt(document.getElementById('km-amount').value);

  if(!email || !email.includes('@')){ notify('Email requis pour recevoir votre photo','error'); return; }
  if(!amount || amount<1){ notify('Montant invalide','error'); return; }

  const stripeLink = STATE.config.stripeKm;
  if(stripeLink && stripeLink.startsWith('http')){
    // Pre-register before redirecting to Stripe
    STATE.adopted[km] = {name,email,amount,message,visibility,paid:false,photo:'',date:new Date().toLocaleDateString('fr-FR')};
    saveState();
    closeModal('km-modal');
    notify('Redirection vers le paiement Stripe...','info');
    setTimeout(()=>{ window.open(stripeLink+'?client_reference_id=km'+km,'_blank'); },800);
  } else {
    // Demo mode: mark as adopted directly
    STATE.adopted[km] = {name,email,amount,message,visibility,paid:true,photo:'',date:new Date().toLocaleDateString('fr-FR')};
    saveState();
    closeModal('km-modal');
    buildKmGrid();
    updateStats();
    renderDonors();
    notify('✅ Km '+km+' adopté ! (mode démo — configurez Stripe dans admin)','success');
    addAutoNews('km','Km '+km+' adopté !',name+' a adopté le km '+km+' pour '+amount+' €. Merci !');
    renderNews();
  }
}

