        <button class="btn-cancel" onclick="closeModal('auth-modal')">Annuler</button>
        <button class="btn-confirm" onclick="sendAuthCode()">Envoyer le code</button>
      </div>
    </div>
    <div id="auth-step2" style="display:none;">
