function updateStats(){
  const adoptedKeys = Object.keys(STATE.adopted).map(Number);
  const totalDons = adoptedKeys.reduce((s,k)=>s+(STATE.adopted[k].amount||0),0);
  const sponsorsKeys = Object.keys(STATE.sponsors);
  const totalSponsor = sponsorsKeys.reduce((s,k)=>s+(STATE.sponsors[k].amount||0),0);
  document.getElementById('stat-km').textContent = adoptedKeys.length;
  document.getElementById('stat-dons').textContent = (totalDons+totalSponsor).toLocaleString('fr-FR')+' €';
  document.getElementById('stat-sponsors').textContent = sponsorsKeys.length;
  document.getElementById('stat-donateurs').textContent = adoptedKeys.length + sponsorsKeys.length;
  const pct = Math.round(adoptedKeys.length/KM_MAX*100);
  document.getElementById('progress-fill').style.width=pct+'%';
  document.getElementById('pct-label').textContent = adoptedKeys.length+' km adoptés sur 6 000';
}

function renderDonors(){
  const list = document.getElementById('donors-list');
  const keys = Object.entries(STATE.adopted).filter(([k,v])=>v.paid!==false);
  if(!keys.length){ list.innerHTML='<p style="color:var(--muted);font-size:14px;">Aucun soutien pour l\'instant. Soyez le premier !</p>'; return; }
  list.innerHTML = keys.map(([k,v])=>`
