function checkIfBigCompany(name){
  if(!name) return 'small';
  const bigList = STATE.config.bigCompanies || [];
  return bigList.some(n=>n.toLowerCase()===name.toLowerCase()) ? 'big' : 'small';
}

function checkCompanyTier(){
  const company = document.getElementById('spon-company').value.trim();
  const tier = checkIfBigCompany(company);
  const pos = STICKER_POSITIONS.find(p=>p.id===currentStickerPos);
  if(!pos) return;
  const price = tier==='big' ? pos.bigPrice : pos.smallPrice;
  document.getElementById('spon-price').textContent = price+' €';
  const info = document.getElementById('spon-tier-info');
  if(company && tier==='big'){
    info.style.display='block';
    info.textContent='Grande entreprise identifiée → tarif professionnel appliqué';
  } else if(company){
    info.style.display='block';
    info.style.background='rgba(82,183,136,.08)';
    info.style.borderColor='rgba(82,183,136,.2)';
    info.style.color='var(--green-light)';
    info.textContent='PME/petite entreprise → tarif accessible appliqué';
  } else {
    info.style.display='none';
  }
}

