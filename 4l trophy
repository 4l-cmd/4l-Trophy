// ── GPS / MAP ──
function initMap(){
  if(leafletMap) return;
  leafletMap = L.map('map').setView([43.48,-1.56], 5);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
    attribution:'© OpenStreetMap',
    maxZoom:18
  }).addTo(leafletMap);

  // Route waypoints
  const routePoints = [[43.48,-1.56],[42.83,-1.70],[41.38,2.18],[37.16,-3.60],[36.13,-5.45],[35.78,-5.80],[33.99,-6.85],[31.63,-7.99]];
  routePolyline = L.polyline(routePoints,{color:'rgba(196,98,45,0.5)',weight:2.5,dashArray:'8,5'}).addTo(leafletMap);

  // City markers
  const cities = [
    {ll:[49.49,0.11],name:'🏁 Le Havre',col:'#52B788'},
    {ll:[41.38,2.18],name:'Barcelone',col:'#8B949E'},
    {ll:[36.13,-5.45],name:'Algéciras',col:'#8B949E'},
    {ll:[35.78,-5.80],name:'Tanger',col:'#8B949E'},
    {ll:[31.63,-7.99],name:'🏆 Marrakech',col:'#C4622D'},
  ];
  cities.forEach(c=>{
    L.circleMarker(c.ll,{radius:5,fillColor:c.col,color:c.col,fillOpacity:1,weight:0})
      .bindTooltip(c.name,{permanent:false,direction:'right'})
      .addTo(leafletMap);
  });

  // Car marker (current position from gpsLog)
  const carIcon = L.divIcon({className:'',html:'<div style="background:#C4622D;color:white;border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;border:2px solid white;box-shadow:0 2px 8px rgba(0,0,0,.5);">4L</div>',iconSize:[28,28],iconAnchor:[14,14]});
  const startPos = STATE.gpsLog.length ? [STATE.gpsLog[STATE.gpsLog.length-1].lat||43.48, STATE.gpsLog[STATE.gpsLog.length-1].lng||-1.56] : [43.48,-1.56];
  carMarker = L.marker(startPos,{icon:carIcon}).bindTooltip('4L HAVRAID',{permanent:true,direction:'right',offset:[12,0]}).addTo(leafletMap);
}

function renderGpsLog(){
  const log = document.getElementById('log-list');
  if(!STATE.gpsLog.length){
    log.innerHTML='<div class="log-entry"><div class="log-time">–</div><div><div class="log-place">En préparation</div><div class="log-msg">Le départ aura lieu en 2026. Restez connectés pour suivre notre aventure en temps réel !</div></div></div>';
    return;
  }
  log.innerHTML = [...STATE.gpsLog].reverse().map(e=>`
    <div class="log-entry">
      <div class="log-time">${escapeHtml(e.time||'–')}</div>
      <div>
        <div class="log-place">${escapeHtml(e.place||'')}</div>
        <div class="log-msg">${escapeHtml(e.msg||'')}</div>
      </div>
    </div>
  `).join('');

  // Update last position
  if(STATE.gpsLog.length){
    const last = STATE.gpsLog[STATE.gpsLog.length-1];
    document.getElementById('gps-last-update').textContent = 'Dernière mise à jour : '+last.time;
    document.getElementById('gps-status-text').textContent = last.place ? 'Position actuelle : '+last.place : 'En route · Équipage 4L HAVRAID';
    if(leafletMap && carMarker && last.lat && last.lng){
      carMarker.setLatLng([last.lat,last.lng]);
      leafletMap.setView([last.lat,last.lng],8,{animate:true});
    }
  }
}

