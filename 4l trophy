  document.getElementById('spon-modal-title').textContent = 'Position '+posId+' — '+pos.name;
  document.getElementById('spon-modal-sub').textContent = pos.desc+' ('+pos.size+' · '+pos.dims+')';
  document.getElementById('spon-price').textContent = pos.smallPrice+' €';
  document.getElementById('spon-tier-info').style.display='none';
  document.getElementById('spon-company').value='';
  document.getElementById('spon-contact').value='';
  document.getElementById('spon-email').value='';
  document.getElementById('spon-phone').value='';
  document.getElementById('spon-address').value='';
  document.getElementById('spon-siret').value='';
  openModal('sponsor-modal');
}

function proceedSponsorPayment(){
  const company = document.getElementById('spon-company').value.trim();
  const contact = document.getElementById('spon-contact').value.trim();
  const email = document.getElementById('spon-email').value.trim();
  const phone = document.getElementById('spon-phone').value.trim();
  const address = document.getElementById('spon-address').value.trim();
  const siret = document.getElementById('spon-siret').value.trim();

  if(!company){ notify('Nom d\'entreprise requis','error'); return; }
  if(!email || !email.includes('@')){ notify('Email professionnel requis','error'); return; }

  const pos = STICKER_POSITIONS.find(p=>p.id===currentStickerPos);
  const tier = checkIfBigCompany(company);
  const price = tier==='big' ? pos.bigPrice : pos.smallPrice;

  const pendingSponsor = {company,contact,email,phone,address,siret,posId:currentStickerPos,posName:pos.name,tier,amount:price,paid:false,date:new Date().toLocaleDateString('fr-FR')};

  const stripeLink = STATE.config.stripeSpon['pos'+currentStickerPos] || STATE.config.stripeKm;
  if(stripeLink && stripeLink.startsWith('http')){
    // Save pending
    STATE.sponsors[currentStickerPos] = pendingSponsor;
    saveState();
    closeModal('sponsor-modal');
    generateInvoicePDF(pendingSponsor, false);
    notify('Redirection vers Stripe...','info');
    setTimeout(()=>{ window.open(stripeLink,'_blank'); },800);
  } else {
    // Demo mode
    pendingSponsor.paid = true;
    STATE.sponsors[currentStickerPos] = pendingSponsor;
    saveState();
    closeModal('sponsor-modal');
    updateStats();
    renderSponsors();
    buildKmGrid();
    // Mark in SVG
    const g = document.getElementById('sp-'+currentStickerPos);
    if(g) g.classList.add('taken');
    addAutoNews('sponsor','Nouveau sponsor : '+company,'L\'entreprise '+company+' rejoint l\'aventure 4L HAVRAID en tant que sponsor ! Bienvenue 🤝',null);
    renderNews();
    generateInvoicePDF(pendingSponsor, true);
    notify('✅ Sponsor ajouté ! Facture générée. (mode démo)','success');
  }
}

function renderSponsors(){
  const grid = document.getElementById('sponsors-grid');
  const entries = Object.values(STATE.sponsors).filter(s=>s.paid);
  if(!entries.length){ grid.innerHTML='<p style="color:var(--muted);font-size:14px;">Soyez le premier à rejoindre l\'aventure !</p>'; return; }
  grid.innerHTML = entries.map(s=>`
    <div class="sponsor-badge">
